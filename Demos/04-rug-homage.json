{
  "name": "04-rug-homage",
  "display": "1470x956@2",
  "clock": "10:00",
  "seed": 1,
  "steps": [
    { "comment": "O1: the felt desk mat lies on the desk, the keyboard weighing it down (the whole room sits over Finder's icons)." },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "underMat": 0, "bumps": 0, "mat.folded": false, "mat.size": "204x84",
                  "mat.angle": 0, "mat.keyboard": "254,52", "mat.asleep": true } },
    { "snapshot": "01-mat" },
    { "hover": "mat.edge.w" },
    { "wait": 0.4 },
    { "expect": { "tooltip": "Desk Mat", "hover.part": "mat.edge" } },
    { "snapshot": "01b-edge-curl" },

    { "comment": "O5: a file dropped on the mat tucks under it where it lands; only a bump shows." },
    { "drag": { "from": "token:todo.txt", "to": "core:330,220", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "token:todo.txt": "desk", "hidden": true, "underMat": 1, "bumps": 1, "piles": 1 } },
    { "snapshot": "02-tucked-under" },

    { "comment": "O6: taller stacks, bigger bumps: four more dropped on the same spot join that pile under the mat." },
    { "drag": { "from": "token:notes.md", "to": "core:331,220", "duration": 0.4, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "drag": { "from": "token:readme.txt", "to": "core:331,220", "duration": 0.4, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "drag": { "from": "token:main.swift", "to": "core:331,220", "duration": 0.4, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "drag": { "from": "token:data.json", "to": "core:331,220", "duration": 0.4, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "token:data.json": "desk", "hidden": true, "underMat": 5, "bumps": 1, "piles": 1, "bump.max": 11 } },
    { "snapshot": "03-bigger-bump" },

    { "comment": "O5: the brush pushes a pile set down beside the mat in under its edge (frames of the push)." },
    { "drag": { "from": "token:slides.pdf", "to": "core:384,212", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "piles": 2, "underMat": 5, "token:slides.pdf": "desk", "hidden": false } },
    { "drag": { "from": "brush", "to": "core:414,219", "duration": 0.5, "hold": true } },
    { "snapshot": "04a-brush-behind" },
    { "move": { "to": "core:392,219", "duration": 0.4 } },
    { "snapshot": "04b-brush-pushing" },
    { "move": { "to": "core:372,219", "duration": 0.4 } },
    { "snapshot": "04c-brush-at-edge" },
    { "move": { "to": "core:358,219", "duration": 0.3 } },
    { "wait": 0.2 },
    { "snapshot": "04d-swept-under" },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "token:slides.pdf": "desk", "hidden": true, "underMat": 6, "piles": 2 } },
    { "snapshot": "04e-brush-done" },
    { "click": { "at": "brush", "count": 2 } },
    { "waitIdle": 2 },
    { "expect": { "brush.home": true, "brush": "442,60" } },

    { "comment": "The scroll-broom: a horizontal two-finger scroll over the bare desk sweeps a pile in under the left edge." },
    { "drag": { "from": "token:song.mp3", "to": "core:118,212", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "piles": 3, "underMat": 6 } },
    { "scroll": { "at": "core:100,219", "dx": 12 } },
    { "wait": 0.05 },
    { "scroll": { "at": "core:100,219", "dx": 12 } },
    { "wait": 0.05 },
    { "scroll": { "at": "core:100,219", "dx": 12 } },
    { "wait": 0.05 },
    { "scroll": { "at": "core:100,219", "dx": 12 } },
    { "waitIdle": 3 },
    { "expect": { "token:song.mp3": "desk", "hidden": true, "underMat": 7, "bumps": 3 } },
    { "snapshot": "05-broomed-under" },

    { "comment": "O7: Peek Under turns up the edge nearest the click: the pile under it pops up; its front file is picked out, then (⇧) the rest." },
    { "menu": { "at": "core:316,224", "item": "peekUnder" } },
    { "wait": 0.4 },
    { "expect": { "revealed": 6, "underMat": 1 } },
    { "snapshot": "06-peek" },
    { "drag": { "from": "token:data.json", "to": "cell:8,4", "duration": 0.3 } },
    { "expect": { "token:data.json": "screen", "token:todo.txt": "desk" } },
    { "drag": { "from": "token:todo.txt", "to": "cell:8,3", "duration": 0.3, "mods": ["shift"] } },
    { "waitIdle": 10 },
    { "expect": { "token:todo.txt": "screen", "token:notes.md": "screen", "underMat": 2, "revealed": 0, "bumps": 2 } },
    { "snapshot": "07-taken-out" },

    { "comment": "O8: peel the front-right corner back past the middle and let go: the flap stays folded, rubber side up (frames)." },
    { "drag": { "from": "mat.corner.se", "to": "core:350,212", "duration": 0.25, "hold": true } },
    { "snapshot": "08a-peel" },
    { "move": { "to": "core:342,200", "duration": 0.3 } },
    { "snapshot": "08b-peel" },
    { "move": { "to": "core:334,188", "duration": 0.3 } },
    { "snapshot": "08c-peel-past-middle" },
    { "release": true },
    { "hover": "point:30,370" },
    { "wait": 0.15 },
    { "snapshot": "08d-laid-down" },
    { "wait": 5 },
    { "waitIdle": 10 },
    { "expect": { "mat.folded": true, "mat.asleep": true, "token:slides.pdf": "desk", "hidden": false } },
    { "wait": 2 },
    { "expect": { "mat.folded": true } },
    { "snapshot": "08e-fold-persists" },
    { "click": { "at": "mat.flap", "count": 2 } },
    { "waitIdle": 10 },
    { "expect": { "mat.folded": false, "token:slides.pdf": "desk", "hidden": true } },
    { "snapshot": "09-unfolded" },

    { "comment": "O2/O10: carry the mat by its middle: it moves as a whole, the keyboard riding along, and trails wrinkles that stay." },
    { "drag": { "from": "core:180,214", "to": "core:200,208", "duration": 0.15, "hold": true } },
    { "snapshot": "10a-carry" },
    { "move": { "to": "core:222,204", "duration": 0.15 } },
    { "snapshot": "10b-carry" },
    { "release": true },
    { "wait": 5 },
    { "waitIdle": 10 },
    { "expect": { "mat.wrinkled": true, "mat.asleep": true, "mat.saved": true } },
    { "snapshot": "10c-creased" },

    { "comment": "O9: tug a corner outward to pull the wrinkles flat (frames); then Smooth Mat from its menu." },
    { "drag": { "from": "mat.corner.sw", "to": "core:150,222", "duration": 0.2, "hold": true } },
    { "expect": { "mat.grab": "tug" } },
    { "snapshot": "11a-tug" },
    { "move": { "to": "core:145,223", "duration": 0.1 } },
    { "snapshot": "11b-tug" },
    { "move": { "to": "core:140,224", "duration": 0.1 } },
    { "snapshot": "11c-tug" },
    { "release": true },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "snapshot": "11d-tugged" },
    { "menu": { "at": "mat.edge.e", "item": "smoothMat" } },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "expect": { "mat.wrinkled": false } },
    { "snapshot": "11e-smoothed" },

    { "comment": "O3/O4: ⌥-drag a corner: the opposite corner stays put; the mat grows (each side as far as it fits the desk). Size ▸ Small, then Rotate +15°, which the smaller mat has room for." },
    { "drag": { "from": "mat.corner.ne", "to": "core:400,184", "duration": 0.5, "hold": true, "mods": ["opt"] } },
    { "expect": { "mat.handles": true, "mat.grab": "transform" } },
    { "snapshot": "12a-resize-handles" },
    { "release": true },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "expect": { "mat.size": "264x96", "mat.handles": false, "mat.folded": false } },
    { "snapshot": "12b-resized" },
    { "menu": { "at": "mat.edge.e", "item": "size.small" } },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "expect": { "mat.size": "150x60" } },
    { "snapshot": "12c-small" },
    { "menu": { "at": "mat.edge.e", "item": "rotate.ccw" } },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "expect": { "mat.angle": 14, "mat.folded": false } },
    { "snapshot": "13-rotated" },
    { "menu": { "at": "mat.edge.e", "item": "resetMat" } },
    { "hover": "point:30,370" },
    { "waitIdle": 10 },
    { "expect": { "mat.size": "204x84", "mat.angle": 0, "mat.keyboard": "254,52", "underMat": 2 } },
    { "snapshot": "14-reset" }
  ]
}
