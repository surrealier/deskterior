{
  "name": "13-file-actions",
  "clock": "10:00",
  "seed": 1,
  "lights": "day",
  "steps": [
    { "comment": "M11: the explicit file actions, for real, on the fixture: files change only through FileOperator and only into the FakeTrash (<state>/FakeTrash)." },
    { "waitIdle": 5 },
    { "fs": { "ls": "desk" } },
    { "snapshot": "00-start" },

    { "comment": "Move to Trash from the token's menu: the file goes to the FakeTrash and the token poofs." },
    { "expect": { "token:todo.txt": "cell:0,3,3", "undo": "none" } },
    { "menu": { "at": "token:todo.txt", "item": "trash" } },
    { "waitFor": { "expect": { "token:todo.txt": "missing" }, "within": 3 } },
    { "snapshot": "01-poof" },
    { "expect": { "effect": "trash", "undo": "Move to Trash", "fileOps": 1, "toast": "none" } },
    { "waitIdle": 3 },
    { "fs": { "ls": "desk" } },
    { "fs": { "ls": "trash" } },
    { "comment": "Undo renames it back out of the FakeTrash: same inode, same cell." },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "token:todo.txt": "cell:0,3,3", "key:todo.txt": "same" }, "within": 3 } },
    { "expect": { "effect": "undo", "undo": "none", "fileOps": 2 } },
    { "waitIdle": 3 },
    { "fs": { "ls": "desk" } },
    { "fs": { "ls": "trash" } },

    { "comment": "Three files into the wastebasket (hidden, not deleted), then Empty Wastebasket…: its sheet lists them and Cancel is the default." },
    { "menu": { "at": "token:file 2.txt", "item": "moveTo.wastebasket" } },
    { "menu": { "at": "token:file 10.txt", "item": "moveTo.wastebasket" } },
    { "menu": { "at": "token:file (1).txt", "item": "moveTo.wastebasket" } },
    { "waitIdle": 3 },
    { "expect": { "balls": 3 } },
    { "menu": { "at": "wastebasket.body", "item": "emptyWastebasket", "confirm": false, "sheetSnapshot": "02-sheet" } },
    { "expect": { "sheet": "emptyWastebasket:3", "balls": 3, "fileOps": 2 } },
    { "menu": { "at": "wastebasket.body", "item": "emptyWastebasket", "confirm": true } },
    { "waitFor": { "expect": { "balls": 0 }, "within": 3 } },
    { "snapshot": "03-emptied" },
    { "expect": { "effect": "emptyWastebasket", "undo": "Empty Wastebasket", "token:file 2.txt": "missing", "fileOps": 3 } },
    { "waitIdle": 3 },
    { "fs": { "ls": "trash" } },
    { "comment": "Undo brings all three back into the basket (by identity, so into the basket again)." },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "balls": 3, "token:file 2.txt": "container:wastebasket", "key:file 2.txt": "same" }, "within": 3 } },
    { "waitIdle": 3 },
    { "fs": { "ls": "trash" } },

    { "comment": "Drop-in from a second scratch folder: a same-volume move lands where it was dropped; notes.md clashes with the desk's and arrives as \"notes 2.md\"." },
    { "fs": { "source": "dropped.txt" } },
    { "fs": { "source": "notes.md" } },
    { "fs": { "sourceDir": "Dropped Folder" } },
    { "fs": { "source": "pile note.txt" } },
    { "fs": { "ls": "source" } },
    { "dropIn": { "files": ["dropped.txt", "notes.md"], "at": "cell:7,4" } },
    { "waitFor": { "expect": { "token:dropped.txt": "cell:0,7,4", "token:notes 2.md": "screen" }, "within": 4 } },
    { "expect": { "effect": "import", "undo": "Drop In", "token:notes.md": "screen" } },
    { "waitIdle": 3 },
    { "snapshot": "04-dropped" },
    { "fs": { "ls": "desk" } },
    { "fs": { "ls": "source" } },
    { "comment": "With ⌥ it is a copy (the folder stays in the source); dropped on the shut left drawer it is chomped inside." },
    { "dropIn": { "files": ["Dropped Folder"], "at": "riser.drawerL.front", "mods": ["opt"] } },
    { "waitFor": { "expect": { "token:Dropped Folder": "container:riserLeft" }, "within": 4 } },
    { "comment": "On the bare desk: a new pile where it was dropped." },
    { "dropIn": { "files": ["pile note.txt"], "at": "core:96,206" } },
    { "waitFor": { "expect": { "token:pile note.txt": "desk" }, "within": 4 } },
    { "waitIdle": 3 },
    { "snapshot": "05-copied-and-piled" },
    { "fs": { "ls": "source" } },
    { "comment": "Undo three times: the pile's file goes back to the source, the copy goes to the FakeTrash, the two moved files go back (notes 2.md as notes.md)." },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "token:pile note.txt": "missing" }, "within": 3 } },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "token:Dropped Folder": "missing" }, "within": 3 } },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "token:dropped.txt": "missing", "token:notes 2.md": "missing", "token:notes.md": "screen" }, "within": 3 } },
    { "waitIdle": 3 },
    { "fs": { "ls": "source" } },
    { "fs": { "ls": "trash" } },
    { "comment": "A desk item dropped back from its own folder only moves on the desk (no file change)." },
    { "dropIn": { "files": ["readme.txt"], "from": "desk", "at": "cell:8,4" } },
    { "expect": { "token:readme.txt": "cell:0,8,4", "undo": "Move", "key:readme.txt": "same" } },

    { "comment": "The drive hub with five fake volumes (demos never list the real ones): four stand in it, the fifth behind \"+1\"." },
    { "volumes": [
      { "id": "V-USB", "name": "KEYCHAIN", "path": "/Volumes/KEYCHAIN", "kind": "removable", "isEjectable": true },
      { "id": "V-DISK", "name": "Backup", "path": "/Volumes/Backup", "kind": "externalDisk", "isEjectable": true },
      { "id": "V-NAS", "name": "Studio NAS", "path": "/Volumes/Studio NAS", "kind": "server", "isEjectable": true },
      { "id": "V-CARD", "name": "SD Card", "path": "/Volumes/SD Card", "kind": "removable", "isEjectable": true },
      { "id": "V-ARCH", "name": "Archive", "path": "/Volumes/Archive", "kind": "externalDisk", "isEjectable": true }
    ] },
    { "waitIdle": 2 },
    { "expect": { "drives": 4, "drives.more": 1 } },
    { "hover": "hub.drive.1" },
    { "wait": 0.4 },
    { "expect": { "tooltip": "Backup" } },
    { "snapshot": "06-drive-hub" },
    { "click": { "at": "hub.drive.0", "count": 2 } },
    { "expect": { "effect": "open" } },
    { "comment": "Eject goes through FileOperator, which refuses every eject in demo mode (the sandbox): a toast, nothing unmounted." },
    { "menu": { "at": "hub.drive.1", "item": "drive.eject" } },
    { "waitFor": { "expect": { "toast": "ejectFailed" }, "within": 3 } },
    { "expect": { "effect": "eject" } },
    { "menu": { "at": "hub.more", "item": "drive.4.reveal" } },
    { "expect": { "effect": "reveal" } },
    { "comment": "A token dropped on a drive bonks: copying to drives is Finder's job." },
    { "drag": { "from": "token:readme.txt", "to": "hub.drive.2", "duration": 0.4 } },
    { "expect": { "bonks": 1, "toast": "drivesReadOnly" } },
    { "waitIdle": 2 },
    { "expect": { "token:readme.txt": "cell:0,8,4" } },

    { "comment": "Dragged out to another app that copied it: nothing changes on the desk." },
    { "dragOut": { "from": "token:readme.txt", "operation": "copy" } },
    { "expect": { "held": 0, "token:readme.txt": "cell:0,8,4" } },
    { "comment": "Dragged out to the Dock Trash (.delete): 1.5 s later the file is still there, so the desk trashes it itself (dragToTrash), undoably." },
    { "dragOut": { "from": "token:Untitled.txt", "operation": "delete" } },
    { "expect": { "held": 1 } },
    { "waitFor": { "expect": { "token:Untitled.txt": "missing", "held": 0 }, "within": 5 } },
    { "expect": { "undo": "Move to Trash", "effect": "trash" } },
    { "waitIdle": 3 },
    { "fs": { "ls": "trash" } },
    { "fs": { "ls": "desk" } },
    { "snapshot": "07-end" }
  ]
}
