{
  "name": "08-phone",
  "display": "1470x956@2",
  "clock": "10:00",
  "seed": 1,
  "steps": [
    { "comment": "Drop tokens on the face-up phone: each becomes a 5×5 app mini (two columns, three rows)." },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "tokens": 40, "phone": "faceUp", "minis": 0 } },
    { "snapshot": "01-start" },
    { "drag": { "from": "token:todo.txt", "to": "phone", "duration": 0.3 } },
    { "wait": 0.1 },
    { "snapshot": "02-bloop" },
    { "waitIdle": 2 },
    { "expect": { "token:todo.txt": "container:phone", "hidden": false, "minis": 1 } },
    { "click": "token:IMG_0001.png" },
    { "click": { "at": "token:slides.pdf", "mods": ["shift"] } },
    { "click": { "at": "token:song.mp3", "mods": ["shift"] } },
    { "click": { "at": "token:clip.mov", "mods": ["shift"] } },
    { "click": { "at": "token:archive.zip", "mods": ["shift"] } },
    { "drag": { "from": "token:slides.pdf", "to": "phone", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:archive.zip": "container:phone", "minis": 6 } },
    { "snapshot": "03-six-minis" },

    { "comment": "A seventh bonks: the phone holds six." },
    { "drag": { "from": "token:notes.md", "to": "phone", "duration": 0.3 } },
    { "wait": 0.1 },
    { "expect": { "bonks": 1, "toast": "containerFull", "token:notes.md": "screen" } },
    { "waitIdle": 4 },

    { "comment": "Minis are tokens: hover names one, a click selects it." },
    { "hover": "token:song.mp3" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "song.mp3" } },
    { "snapshot": "04-mini-hover" },
    { "click": "token:song.mp3" },
    { "expect": { "selection": 1 } },
    { "hover": "core:300,200" },
    { "snapshot": "05-mini-selected" },

    { "comment": "A click on the stand flips it face down: three edge frames; the contents hide at once; drops bonk." },
    { "click": "core:392,170" },
    { "wait": 0.1 },
    { "expect": { "phone": "faceDown", "token:song.mp3": "container:phone", "hidden": true, "minis": 0, "selection": 0 } },
    { "snapshot": "06-flipping" },
    { "waitIdle": 2 },
    { "snapshot": "07-face-down" },
    { "drag": { "from": "token:notes.md", "to": "phone", "duration": 0.3 } },
    { "wait": 0.1 },
    { "expect": { "bonks": 2, "token:notes.md": "screen" } },
    { "waitIdle": 4 },

    { "comment": "Turn Face Up from its menu; then carry a mini back to the screen." },
    { "menu": { "at": "core:392,170", "item": "faceUp" } },
    { "waitIdle": 2 },
    { "expect": { "phone": "faceUp", "token:song.mp3": "container:phone", "hidden": false, "minis": 6 } },
    { "drag": { "from": "token:todo.txt", "to": "cell:6,4", "duration": 0.4, "hold": true } },
    { "expect": { "carrying": true } },
    { "snapshot": "08-carry-out" },
    { "release": true },
    { "waitIdle": 2 },
    { "expect": { "token:todo.txt": "cell:0,6,4", "minis": 5 } },
    { "snapshot": "09-back-on-screen" }
  ]
}
