{
  "name": "05-pencup-spill",
  "display": "1470x956@2",
  "clock": "10:00",
  "seed": 1,
  "steps": [
    { "comment": "Pens in the cup, piles on the desk, carry the cup, flick it over, the spill, stand it up, pens back." },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "tokens": 40, "penCup": "upright", "pens": 0 } },

    { "drag": { "from": "token:todo.txt", "to": "pencup.mouth", "duration": 0.4 } },
    { "drag": { "from": "token:notes.md", "to": "pencup.mouth", "duration": 0.4 } },
    { "drag": { "from": "token:main.swift", "to": "pencup.mouth", "duration": 0.4 } },
    { "drag": { "from": "token:slides.pdf", "to": "pencup.mouth", "duration": 0.4 } },
    { "drag": { "from": "token:song.mp3", "to": "pencup.mouth", "duration": 0.4 } },
    { "waitIdle": 2 },
    { "expect": { "token:todo.txt": "container:penCup", "token:song.mp3": "container:penCup", "pens": 5, "hidden": true } },
    { "hover": "pencup" },
    { "wait": 0.4 },
    { "expect": { "tooltip": "Pen Cup" } },
    { "snapshot": "01-pens-in-cup" },

    { "comment": "Set down gently (a pause before letting go): piles; the second joins the first." },
    { "drag": { "from": "token:IMG_0001.png", "to": "core:150,214", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "drag": { "from": "token:IMG_0002.png", "to": "core:153,213", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "drag": { "from": "token:readme.txt", "to": "core:330,222", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "token:IMG_0001.png": "desk", "token:IMG_0002.png": "desk", "token:readme.txt": "desk", "piles": 2,
                  "undo": "Move" } },
    { "snapshot": "02-piles-on-desk" },

    { "drag": { "from": "pencup.body", "to": "core:400,218", "duration": 0.8, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "penCup": "upright", "pens": 5 } },
    { "snapshot": "03-cup-carried" },

    { "comment": "A flick faster than 400 px/s with three pens or more tips it over that way." },
    { "drag": { "from": "pencup.body", "to": "core:445,218", "duration": 0.05 } },
    { "wait": 0.12 },
    { "snapshot": "04-tipping" },
    { "wait": 0.25 },
    { "snapshot": "05-spilling" },
    { "wait": 0.25 },
    { "snapshot": "06-spilling-more" },
    { "waitIdle": 6 },
    { "expect": { "penCup": "lyingRight", "pens": 0 } },
    { "snapshot": "07-spilled" },

    { "click": "pencup" },
    { "waitIdle": 2 },
    { "expect": { "penCup": "upright" } },
    { "snapshot": "08-stood-up" },

    { "comment": "A desk knock (double-click the apron, left of the chair): piles and floor tokens hop, the cup and monitor wobble; nothing moves house." },
    { "expect": { "piles": 5, "floor": 2, "knocks": 0 } },
    { "click": { "at": "core:150,238", "count": 2 } },
    { "wait": 0.1 },
    { "snapshot": "08b-knock" },
    { "expect": { "knocks": 1 } },
    { "click": { "at": "core:150,238", "count": 2 } },
    { "expect": { "knocks": 1 } },
    { "waitIdle": 2 },
    { "expect": { "piles": 5, "floor": 2, "penCup": "upright" } },

    { "drag": { "from": "token:todo.txt", "to": "pencup.mouth", "duration": 0.5 } },
    { "waitIdle": 2 },
    { "expect": { "token:todo.txt": "container:penCup", "pens": 1 } },
    { "drag": { "from": "pencup.mouth", "to": "cell:8,4", "duration": 0.5 } },
    { "waitIdle": 2 },
    { "expect": { "token:todo.txt": "screen", "pens": 0 } },
    { "snapshot": "09-pen-back-out" },

    { "menu": { "at": "pencup", "item": "tipOver" } },
    { "waitIdle": 2 },
    { "expect": { "penCup": "lyingLeft" } },
    { "menu": { "at": "pencup", "item": "standUp" } },
    { "waitIdle": 2 },
    { "expect": { "penCup": "upright" } }
  ]
}
