{
  "name": "02-monitor-power",
  "display": "1470x956@2",
  "clock": "10:00",
  "seed": 1,
  "firstRun": true,
  "steps": [
    { "comment": "First run: the connect prompt; Finder-hidden asks first; ⏻ (Show) connects." },
    { "waitIdle": 2 },
    { "expect": { "access": "notConnected", "monitor.overlay": "connectPrompt", "tokens": 0 } },
    { "snapshot": "01-connect-prompt" },
    { "action": "finderHidesItems" },
    { "waitIdle": 2 },
    { "expect": { "monitor.overlay": "desktopHidden" } },
    { "snapshot": "02-desktop-hidden" },
    { "click": "card.show" },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "monitor.overlay": "none", "tokens": 40 } },
    { "snapshot": "03-connected" },

    { "comment": "INPUT: HDMI 1 → AV (static, OSD, the bouncing NO SIGNAL logo) → HDMI 1." },
    { "click": "monitor.input" },
    { "wait": 0.05 },
    { "snapshot": "04-static" },
    { "wait": 0.25 },
    { "expect": { "monitor.input": "AV", "monitor.overlay": "av", "screen.tokens": 0 } },
    { "snapshot": "05-av-osd" },
    { "wait": 3 },
    { "snapshot": "06-av-bounce" },
    { "wait": 8 },
    { "expect": { "monitor.input": "AV" } },
    { "click": "monitor.input" },
    { "waitIdle": 3 },
    { "expect": { "monitor.input": "HDMI 1", "screen.tokens": 40 } },

    { "comment": "⏻ off: the CRT collapse, then black glass; files that arrive meanwhile light the amber LED and +N." },
    { "click": "monitor.power" },
    { "wait": 0.2 },
    { "expect": { "monitor.phase": "poweringOff", "monitor.power": "off" } },
    { "snapshot": "07-crt-collapse" },
    { "waitIdle": 2 },
    { "expect": { "monitor.phase": "off", "monitor.led": "off", "screen.tokens": 0 } },
    { "snapshot": "08-off" },
    { "drag": { "from": "monitor.screen", "to": "cell:2,2", "duration": 0.2 } },
    { "expect": { "carrying": false, "selection": 0 } },
    { "fs": { "touch": "new note.txt" } },
    { "fs": { "touch": "scan 2.txt" } },
    { "waitFor": { "expect": { "monitor.pendingNew": 2 }, "within": 3 } },
    { "wait": 0.1 },
    { "snapshot": "09-badge-blink" },
    { "waitIdle": 3 },
    { "expect": { "monitor.badge": "+2", "monitor.led": "amber" } },
    { "snapshot": "10-badge" },

    { "comment": "⏻ on: the bloom, icons pop in row by row; the badge clears." },
    { "click": "monitor.power" },
    { "wait": 0.35 },
    { "snapshot": "11-crt-bloom" },
    { "wait": 0.45 },
    { "snapshot": "12-pop-in" },
    { "waitIdle": 3 },
    { "expect": { "monitor.phase": "on", "monitor.badge": "none", "monitor.pendingNew": 0, "token:new note.txt": "screen" } },
    { "snapshot": "13-on" },

    { "comment": "Access denied: NO SIGNAL with Open Settings / Choose Folder…" },
    { "action": "accessDenied" },
    { "waitIdle": 3 },
    { "expect": { "monitor.overlay": "noAccess", "screen.tokens": 0 } },
    { "snapshot": "14-no-signal" },
    { "click": "card.chooseFolder" },
    { "expect": { "effect": "chooseFolder" } },
    { "click": "card.openSettings" },
    { "expect": { "effect": "openPrivacySettings" } }
  ]
}
