{
  "name": "16-picture-frame",
  "clock": "2026-10-18T10:00",
  "seed": 1,
  "lights": "day",
  "steps": [
    { "comment": "Erratum 33: a photo of your own in the framed print above the wall shelf; the file is only read." },
    { "waitIdle": 5 },
    { "expect": { "access": "connected", "framePhoto": "none", "routed:frame": true, "out:wallShelf": "out" } },
    { "snapshot": "00-print" },
    { "hover": "frame" },
    { "wait": 1 },
    { "expect": { "tooltip": "Picture Frame", "hover.part": "frame" } },
    { "click": "frame" },
    { "expect": { "command": "choosePhoto", "framePhoto": "none" } },
    { "comment": "A photo carried from the monitor onto the frame hangs there; its icon springs back to its cell." },
    { "drag": { "from": "token:IMG_0001.png", "to": "frame", "duration": 0.5 } },
    { "waitFor": { "expect": { "framePhoto": "hung", "undo": "Hang Photo" }, "within": 5 } },
    { "waitIdle": 2 },
    { "expect": { "command": "hangInFrame", "token:IMG_0001.png": "screen:1", "key:IMG_0001.png": "same", "fileOps": 0 } },
    { "snapshot": "01-photo-day" },
    { "wall": "02-wall-day" },
    { "comment": "A text file carried onto the frame bonks and says why." },
    { "drag": { "from": "token:notes.md", "to": "frame", "duration": 0.4 } },
    { "wait": 0.2 },
    { "expect": { "toast": "notAPhoto", "bonks": 1, "token:notes.md": "screen:1", "framePhoto": "hung" } },
    { "waitIdle": 2 },
    { "comment": "Hang in Picture Frame from another photo's menu, onto an emptied frame: only the menu can hang it." },
    { "action": "removePhoto" },
    { "waitIdle": 2 },
    { "expect": { "framePhoto": "none", "undo": "Remove Photo" } },
    { "menu": { "at": "token:IMG_0002.png", "item": "hangInFrame" } },
    { "waitFor": { "expect": { "framePhoto": "hung", "undo": "Hang Photo" }, "within": 5 } },
    { "waitIdle": 2 },
    { "expect": { "command": "hangInFrame", "key:IMG_0002.png": "same", "fileOps": 0 } },
    { "snapshot": "03-second-photo" },
    { "comment": "A Finder drop of a photo from outside the desk folder onto the emptied frame hangs it; nothing is imported." },
    { "action": "removePhoto" },
    { "waitIdle": 2 },
    { "expect": { "framePhoto": "none" } },
    { "fs": { "sourceImage": "harbour.png" } },
    { "fs": { "ls": "source" } },
    { "dropIn": { "files": ["harbour.png"], "at": "frame" } },
    { "waitFor": { "expect": { "framePhoto": "hung" }, "within": 5 } },
    { "waitIdle": 3 },
    { "expect": { "source:harbour.png": "present", "token:harbour.png": "missing", "fileOps": 0, "effect": "none", "undo": "Hang Photo" } },
    { "fs": { "ls": "source" } },
    { "comment": "A text file dropped on the frame from Finder bonks, says why and stays in its folder." },
    { "fs": { "source": "letter.txt" } },
    { "dropIn": { "files": ["letter.txt"], "at": "frame" } },
    { "wait": 0.2 },
    { "expect": { "toast": "notAPhoto", "bonks": 2, "source:letter.txt": "present", "token:letter.txt": "missing", "fileOps": 0, "framePhoto": "hung" } },
    { "waitIdle": 2 },
    { "comment": "At night the photo dims with the room, on the desk and on another display's wall." },
    { "action": "lights:night" },
    { "waitIdle": 3 },
    { "snapshot": "04-photo-night" },
    { "wall": "05-wall-night" },
    { "action": "lights:day" },
    { "waitIdle": 2 },
    { "comment": "Remove Photo brings the print back; ⌘Z hangs the photo again." },
    { "menu": { "at": "frame", "item": "removePhoto" } },
    { "waitIdle": 2 },
    { "expect": { "framePhoto": "none", "undo": "Remove Photo" } },
    { "snapshot": "06-print-again" },
    { "key": "cmd+z" },
    { "waitIdle": 2 },
    { "expect": { "framePhoto": "hung" } },
    { "comment": "The frame goes with the wall shelf and keeps its photo." },
    { "menu": { "at": "frame", "item": "putAway" } },
    { "waitIdle": 3 },
    { "expect": { "out:wallShelf": "away", "routed:frame": false, "framePhoto": "hung" } },
    { "action": "bringBack:wallShelf" },
    { "waitIdle": 3 },
    { "expect": { "out:wallShelf": "out", "routed:frame": true, "framePhoto": "hung" } },
    { "snapshot": "07-back" },
    { "action": "removePhoto" },
    { "waitIdle": 2 },
    { "expect": { "framePhoto": "none" } }
  ]
}
