{
  "name": "07-night-lamp",
  "display": "1470x956@2",
  "clock": "18:50",
  "seed": 1,
  "steps": [
    { "comment": "Dusk, room light on. The clock's minute hand previews 19:10: night falls and the room light warms the room." },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "lights.mode": "auto", "phase": "dusk", "ambient": 7, "clock": "18:50" } },
    { "snapshot": "00-dusk" },
    { "drag": { "from": "core:126,29", "to": "core:141,29", "duration": 0.5, "hold": true } },
    { "expect": { "clock": "19:10", "phase": "night", "ambient": 6 } },
    { "snapshot": "01-preview-night" },
    { "release": true },
    { "wait": 0.2 },
    { "snapshot": "02-spring-back" },
    { "waitIdle": 2 },
    { "expect": { "clock": "18:50", "phase": "dusk", "ambient": 7 } },

    { "comment": "A file set down on the right of the desk, out of every light once the room goes dark." },
    { "drag": { "from": "token:readme.txt", "to": "core:470,220", "duration": 0.5, "hold": true } },
    { "wait": 0.1 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "token:readme.txt": "desk", "piles": 1 } },
    { "comment": "Lights ▸ Lamp Only from the wall menu: night, room light off, lamp on; ambient 1." },
    { "menu": { "at": "core:300,4", "item": "lights.lamp" } },
    { "waitIdle": 2 },
    { "expect": { "lights.mode": "lamp", "lights.room": "off", "lights.lamp": "on", "phase": "night", "ambient": 1 } },
    { "expect": { "glow.lamp": "on", "glow.monitor": "on", "glow.phone": "on" } },
    { "snapshot": "03-lamp-only" },

    { "comment": "Only the pool, the monitor's glow and the phone's light a token; the rest of the room is silhouettes." },
    { "expect": { "lit:core:150,207": true, "lit:core:320,181": true, "lit:core:392,170": true } },
    { "expect": { "lit:core:100,295": false, "lit:core:470,215": false, "lit:core:60,200": false, "light:core:100,295": 1 } },
    { "expect": { "lit:token:보고서 final.pdf": true } },
    { "hover": "token:보고서 final.pdf" },
    { "waitIdle": 1 },
    { "expect": { "hover": "보고서 final.pdf", "hover.part": "token" } },

    { "comment": "The pile in the dark is a silhouette: hovering finds no name, and clicks pass it by." },
    { "expect": { "lit:token:readme.txt": false } },
    { "hover": "token:readme.txt" },
    { "waitIdle": 1 },
    { "expect": { "hover.part": "token.dark" } },
    { "comment": "The wall switch: the room light comes on (Night, warm), and off again (Lamp Only again)." },
    { "click": "room.switch" },
    { "waitIdle": 1 },
    { "expect": { "lights.mode": "night", "lights.room": "on", "ambient": 6 } },
    { "snapshot": "04-room-light" },
    { "click": "room.switch" },
    { "waitIdle": 1 },
    { "expect": { "lights.mode": "lamp", "lights.room": "off", "ambient": 1 } },

    { "comment": "The lamp's switch: a three-frame flicker, then dark (Night, everything off); and back on (Lamp Only)." },
    { "click": "lamp.switch" },
    { "expect": { "lights.lamp": "off", "lights.mode": "night" } },
    { "wait": 0.09 },
    { "expect": { "glow.lamp": "on" } },
    { "snapshot": "05-lamp-flicker" },
    { "waitIdle": 1 },
    { "expect": { "glow.lamp": "off", "lit:core:150,207": false, "lit:core:320,181": true } },
    { "snapshot": "06-lamp-off" },
    { "click": "lamp.switch" },
    { "waitIdle": 1 },
    { "expect": { "lights.mode": "lamp", "glow.lamp": "on", "lit:core:150,207": true } },

    { "comment": "The monitor's glow goes with the collapsing CRT and comes back with the bloom; the phone's is state." },
    { "click": "monitor.power" },
    { "wait": 0.1 },
    { "expect": { "monitor.phase": "poweringOff", "glow.monitor": "off" } },
    { "waitIdle": 2 },
    { "expect": { "glow.monitor": "off", "lit:core:320,181": false, "lit:core:392,170": true } },
    { "snapshot": "07-monitor-off" },
    { "click": "monitor.power" },
    { "waitIdle": 3 },
    { "expect": { "glow.monitor": "on", "lit:core:320,181": true } },

    { "comment": "Decor: a key presses for two frames; the plant jiggles for four." },
    { "click": "core:246,211" },
    { "expect": { "keyboard.key": "3,3" } },
    { "waitIdle": 1 },
    { "expect": { "keyboard.key": "none" } },
    { "click": "plant" },
    { "expect": { "plant.jiggle": true } },
    { "wait": 0.05 },
    { "snapshot": "08-plant-jiggle" },
    { "waitIdle": 1 },
    { "expect": { "plant.jiggle": false } },

    { "comment": "Lights ▸ Auto from Lamp Only brings the room light back: dusk again." },
    { "menu": { "at": "core:300,4", "item": "lights.auto" } },
    { "waitIdle": 2 },
    { "expect": { "lights.mode": "auto", "lights.room": "on", "lights.lamp": "on", "phase": "dusk", "ambient": 7 } },
    { "snapshot": "09-dusk-again" }
  ]
}
