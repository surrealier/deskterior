{
  "name": "15-partition-memos",
  "clock": "2026-10-18T21:30",
  "seed": 1,
  "lights": "night",
  "steps": [
    { "comment": "Erratum 31: the desk partition, sticky notes, the daily memo pad, the wall calendar, memo clips and Save as Text File." },
    { "waitIdle": 5 },
    { "expect": { "notes": 0, "out:partition": "out", "calendar.marks": 0, "clipLight": "off" } },
    { "snapshot": "00-bare-partition" },
    { "click": "partition.cube" },
    { "waitIdle": 2 },
    { "expect": { "notes": 1, "note:N1.pos": "371,67", "note:N1.colour": "yellow", "command": "editNote:N1", "undo": "New Sticky Note" } },
    { "action": "noteText:N1:우유 사기" },
    { "action": "newNote:pink:택배 반품" },
    { "action": "newNote:sky:Call mom\nabout Sunday" },
    { "action": "dayMemo:2026-10-18:회의 3시\n자료 준비" },
    { "action": "dDay:2026-10-30:중간고사" },
    { "waitIdle": 2 },
    { "expect": { "notes": 3, "note:N2.pos": "401,67", "note:N3.pos": "371,88", "page:2026-10-18": "회의 3시\n자료 준비", "dDay": "2026-10-30 중간고사", "calendar.marks": 2 } },
    { "snapshot": "01-notes-night" },
    { "hover": "note:N2" },
    { "wait": 1 },
    { "expect": { "tooltip": "택배 반품" } },
    { "drag": { "from": "note:N2", "to": "core:449,152", "duration": 0.4 } },
    { "waitIdle": 2 },
    { "expect": { "note:N2.pos": "434,140", "undo": "Move Note" } },
    { "drag": { "from": "token:notes.md", "to": "partition.clips", "duration": 0.4 } },
    { "waitIdle": 3 },
    { "expect": { "token:notes.md": "container:memoClips", "undo": "Move" } },
    { "snapshot": "02-clipped" },
    { "comment": "Tear today's page off the pad: a cream note dated today; the page goes blank." },
    { "drag": { "from": "partition.pad", "to": "core:419,152", "duration": 0.5 } },
    { "waitIdle": 3 },
    { "expect": { "notes": 4, "note:N4.colour": "cream", "note:N4.day": "2026-10-18", "note:N4.pos": "404,140", "page:2026-10-18": "empty", "undo": "Tear Off Page", "calendar.marks": 2 } },
    { "click": "calendar.day:30" },
    { "expect": { "command": "openMemos:day:2026-10-30" } },
    { "action": "lights:lamp" },
    { "waitIdle": 3 },
    { "expect": { "lit:core:85,139": true, "lit:core:401,79": false } },
    { "snapshot": "03-lamp-only" },
    { "hover": "note:N3" },
    { "wait": 1 },
    { "expect": { "tooltip": "Sticky Note" } },
    { "click": "partition.clipLight" },
    { "waitIdle": 2 },
    { "expect": { "clipLight": "on", "lit:core:401,79": true, "lit:core:449,152": true } },
    { "snapshot": "04-clip-light" },
    { "action": "lights:night" },
    { "waitIdle": 2 },
    { "drag": { "from": "note:N3", "to": "wastebasket.mouth", "duration": 0.5 } },
    { "waitIdle": 2 },
    { "expect": { "note:N3": "missing", "notes": 3, "toast": "noteRemoved", "undo": "Remove Note" } },
    { "key": "cmd+z" },
    { "waitIdle": 2 },
    { "expect": { "note:N3": "present", "note:N3.pos": "371,88" } },
    { "comment": "Save as Text File on Desktop: a new file in the desk folder, clipped to the partition; undo moves it to the FakeTrash." },
    { "menu": { "at": "note:N1", "item": "saveFile" } },
    { "waitFor": { "expect": { "token:우유 사기.txt": "container:memoClips" }, "within": 4 } },
    { "expect": { "effect": "createFile", "undo": "Save as Text File", "toast": "savedTextFile" } },
    { "fs": { "ls": "desk" } },
    { "waitIdle": 3 },
    { "snapshot": "05-saved" },
    { "key": "cmd+z" },
    { "waitFor": { "expect": { "token:우유 사기.txt": "missing", "toast": "undidSaveTextFile" }, "within": 4 } },
    { "fs": { "ls": "trash" } },
    { "comment": "Putting the partition away takes the clipped file out first; undo brings both back." },
    { "menu": { "at": "partition.post", "item": "putAway" } },
    { "waitIdle": 3 },
    { "expect": { "out:partition": "away", "routed:partition": false, "token:notes.md": "screen", "toast": "tookFilesOut", "notes": 4 } },
    { "snapshot": "06-partition-away" },
    { "key": "cmd+z" },
    { "waitIdle": 3 },
    { "expect": { "out:partition": "out", "token:notes.md": "container:memoClips", "note:N2.pos": "434,140" } },
    { "snapshot": "07-back" }
  ]
}
