{
  "name": "03-drawers",
  "display": "1470x956@2",
  "clock": "10:00",
  "seed": 1,
  "steps": [
    { "comment": "The riser: chomp a token into the shut left drawer, peek, open, the minis, close." },
    { "waitIdle": 10 },
    { "expect": { "access": "connected", "tokens": 40, "drawer:riserLeft": "closed", "minis": 0 } },
    { "snapshot": "01-start" },
    { "drag": { "from": "token:IMG_0001.png", "to": "riser.drawerL.front", "duration": 0.3 } },
    { "wait": 0.12 },
    { "snapshot": "02-chomp" },
    { "waitIdle": 2 },
    { "expect": { "token:IMG_0001.png": "container:riserLeft", "hidden": true, "drawer:riserLeft": "closed", "undo": "Move" } },

    { "comment": "Eight more as one stack: nine in a drawer for eight, so it rests ajar with paper poking out." },
    { "click": "token:IMG_0002.png" },
    { "click": { "at": "token:IMG_0003.png", "mods": ["shift"] } },
    { "click": { "at": "token:diagram.png", "mods": ["shift"] } },
    { "click": { "at": "token:icon-badge.png", "mods": ["shift"] } },
    { "click": { "at": "token:song.mp3", "mods": ["shift"] } },
    { "click": { "at": "token:slides.pdf", "mods": ["shift"] } },
    { "click": { "at": "token:notes.md", "mods": ["shift"] } },
    { "click": { "at": "token:installer.dmg", "mods": ["shift"] } },
    { "expect": { "selection": 8 } },
    { "drag": { "from": "token:IMG_0002.png", "to": "riser.drawerL.front", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:song.mp3": "container:riserLeft", "drawer:riserLeft": "ajar", "hidden": true, "selection": 0 } },
    { "snapshot": "03-overfull-ajar" },

    { "comment": "Two-finger scroll peeks (paper only), and it slides back 0.35 s after the last scroll." },
    { "scroll": { "at": "riser.drawerL.front", "dx": 0, "dy": 4 } },
    { "wait": 0.2 },
    { "snapshot": "04-peek" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserLeft": "ajar", "token:song.mp3": "container:riserLeft", "hidden": true } },

    { "comment": "A click opens it: the minis show, hover for a name, click one to select it; a click on the pull shuts it." },
    { "click": "riser.drawerL.handle" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserLeft": "open", "token:IMG_0001.png": "container:riserLeft", "hidden": false, "minis": 9 } },
    { "hover": "token:song.mp3" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "song.mp3" } },
    { "hover": "token:installer.dmg" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "installer.dmg" } },
    { "hover": "token:IMG_0003.png" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "IMG_0003.png" } },
    { "snapshot": "05-open-hover" },
    { "click": "token:IMG_0003.png" },
    { "expect": { "selection": 1 } },
    { "hover": "core:300,200" },
    { "snapshot": "06-mini-selected" },
    { "click": "riser.drawerL.handle" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserLeft": "ajar", "selection": 0, "minis": 0 } },

    { "comment": "Five more jam it (14, its hard cap): it rests 6 px out, a click shut boings back off the paper, the next drop bonks." },
    { "click": "token:file 2.txt" },
    { "click": { "at": "token:file 10.txt", "mods": ["shift"] } },
    { "click": { "at": "token:file (1).txt", "mods": ["shift"] } },
    { "click": { "at": "token:Untitled.txt", "mods": ["shift"] } },
    { "click": { "at": "token:readme.txt", "mods": ["shift"] } },
    { "drag": { "from": "token:file 2.txt", "to": "riser.drawerL.front", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:readme.txt": "container:riserLeft", "drawer:riserLeft": "ajar" } },
    { "snapshot": "07-jammed" },
    { "click": "riser.drawerL.handle" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserLeft": "open" } },
    { "click": "riser.drawerL.handle" },
    { "wait": 0.12 },
    { "snapshot": "08-jam-boing" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserLeft": "ajar" } },
    { "drag": { "from": "token:todo.txt", "to": "riser.drawerL.front", "duration": 0.3 } },
    { "wait": 0.1 },
    { "expect": { "bonks": 1, "toast": "containerFull", "token:todo.txt": "screen" } },
    { "snapshot": "09-bonk" },
    { "waitIdle": 4 },

    { "comment": "The cubby: an open shelf with dim silhouettes; hover names one, a drag takes it back out." },
    { "drag": { "from": "token:main.swift", "to": "riser.cubby", "duration": 0.3 } },
    { "drag": { "from": "token:data.json", "to": "riser.cubby", "duration": 0.3 } },
    { "drag": { "from": "token:page.html", "to": "riser.cubby", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:main.swift": "container:riserCubby", "token:page.html": "container:riserCubby" } },
    { "hover": "token:main.swift" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "main.swift" } },
    { "hover": "token:page.html" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "page.html" } },
    { "hover": "token:data.json" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "data.json" } },
    { "snapshot": "10-cubby" },
    { "drag": { "from": "token:data.json", "to": "screen.empty", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:data.json": "screen", "token:main.swift": "container:riserCubby" } },

    { "comment": "The chair rolled in front of the cabinet blocks its drawers: a pull opens 3 px and thunks the chair aside." },
    { "drag": { "from": "chair", "to": "core:372,270", "duration": 0.6, "hold": true } },
    { "wait": 0.2 },
    { "release": true },
    { "waitIdle": 3 },
    { "expect": { "chair.blocksCabinet": true } },
    { "snapshot": "11-chair-blocks" },
    { "click": "cabinet.top.handle" },
    { "wait": 0.1 },
    { "snapshot": "12-thunk" },
    { "waitIdle": 4 },
    { "expect": { "chair.blocksCabinet": false, "drawer:cabinetTop": "ajar" } },
    { "snapshot": "13-chair-rolled-aside" },
    { "click": "cabinet.top.handle" },
    { "waitIdle": 2 },
    { "expect": { "drawer:cabinetTop": "open" } },

    { "comment": "Four into the file drawer (a chomp shuts the open top drawer: one at a time), then open it: folder tabs." },
    { "click": "token:Meeting notes.docx" },
    { "click": { "at": "token:budget.xlsx", "mods": ["shift"] } },
    { "click": { "at": "token:invoice 2026.pdf", "mods": ["shift"] } },
    { "click": { "at": "token:archive.zip", "mods": ["shift"] } },
    { "drag": { "from": "token:budget.xlsx", "to": "cabinet.file.front", "duration": 0.3 } },
    { "waitIdle": 2 },
    { "expect": { "token:archive.zip": "container:cabinetFile", "drawer:cabinetTop": "closed", "drawer:cabinetFile": "closed" } },
    { "click": "cabinet.file.handle" },
    { "waitIdle": 2 },
    { "expect": { "drawer:cabinetFile": "open", "token:budget.xlsx": "container:cabinetFile", "hidden": false } },
    { "hover": "token:budget.xlsx" },
    { "wait": 0.3 },
    { "expect": { "tooltip": "budget.xlsx" } },
    { "snapshot": "14-file-drawer" },

    { "comment": "Spring-loading: a carry resting on the shut middle front opens it; dropped inside, it shuts 0.8 s later." },
    { "drag": { "from": "token:clip.mov", "to": "cabinet.middle.front", "duration": 0.3, "hold": true } },
    { "wait": 0.75 },
    { "snapshot": "15-spring-loaded" },
    { "release": true },
    { "wait": 0.3 },
    { "expect": { "token:clip.mov": "container:cabinetMiddle" } },
    { "waitIdle": 3 },
    { "expect": { "drawer:cabinetMiddle": "closed", "drawer:cabinetFile": "closed" } },

    { "comment": "Menus: the right drawer opens from its menu; a flick shut slams it (a puff, a shake: the desk-knock hook)." },
    { "menu": { "at": "riser.drawerR.front", "item": "open" } },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserRight": "open" } },
    { "drag": { "from": "riser.drawerR.handle", "to": "core:310,146", "duration": 0.05 } },
    { "wait": 0.1 },
    { "snapshot": "16-slam" },
    { "waitIdle": 2 },
    { "expect": { "drawer:riserRight": "closed" } },

    { "comment": "Take All Out parades the left drawer back to the monitor; emptied, it slides shut off its jam gap." },
    { "menu": { "at": "riser.drawerL.front", "item": "takeAllOut" } },
    { "waitIdle": 4 },
    { "expect": { "token:IMG_0001.png": "screen", "token:readme.txt": "screen", "hidden": false, "undo": "Take All Out",
                  "drawer:riserLeft": "closed" } },
    { "snapshot": "17-taken-out" }
  ]
}
